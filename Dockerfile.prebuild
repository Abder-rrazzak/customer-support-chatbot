# Multi-stage Dockerfile optimisé pour pre-build
FROM python:3.12-slim AS base

# Variables d'environnement pour optimisation
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# Installation des dépendances système
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    git \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Stage pour les dépendances Python
FROM base AS dependencies

# Copie des fichiers de requirements
COPY requirements*.txt ./

# Installation des dépendances avec cache optimisé
RUN pip install --upgrade pip && \
    pip install -r requirements.txt && \
    pip install -r requirements-dev.txt

# Stage pour les modèles ML
FROM dependencies AS ml-models

# Installation des dépendances ML
RUN pip install -r requirements-ml.txt

# Pré-téléchargement des modèles
RUN python -c "from transformers import AutoTokenizer, AutoModel; import subprocess; AutoTokenizer.from_pretrained('distilbert-base-uncased'); AutoModel.from_pretrained('distilbert-base-uncased'); subprocess.run(['python', '-m', 'spacy', 'download', 'en_core_web_sm']); subprocess.run(['python', '-m', 'spacy', 'download', 'fr_core_news_sm'])"

# Stage final de production
FROM ml-models AS production

# Copie du code source
COPY . .

# Création des dossiers nécessaires
RUN mkdir -p data/raw data/processed models metrics logs

# Exposition du port
EXPOSE 8000

# Commande par défaut
CMD ["uvicorn", "src.api.main:app", "--host", "0.0.0.0", "--port", "8000"]